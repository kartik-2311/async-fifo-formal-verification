[options]
# Same Phase 1 properties as async_fifo.sby, but with free independent clocks.
multiclock on

mode bmc
depth 30

[engines]
smtbmc z3

[script]
plugin -i slang
read_slang async_fifo.sv async_fifo_formal.sv -DADDR_WIDTH=2 --top async_fifo
prep -top async_fifo -set ADDR_WIDTH=2

[files]
async_fifo.sv
async_fifo_formal.sv
