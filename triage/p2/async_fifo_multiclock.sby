[tasks]
bmc
prove
cover

[options]
# Same Phase 1 properties as async_fifo.sby, but with free independent clocks.
multiclock on

bmc: mode bmc
bmc: depth 32
prove: mode prove
prove: depth 30
cover: mode cover
cover: depth 30

[engines]
smtbmc z3

[script]
plugin -i slang
read_slang async_fifo.sv async_fifo_formal.sv --top async_fifo
prep -top async_fifo

[files]
async_fifo.sv
async_fifo_formal.sv
