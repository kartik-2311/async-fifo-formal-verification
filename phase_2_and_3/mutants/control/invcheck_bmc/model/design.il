  connect \dut.wr_addr \dut.u_wr_ptr.wr_bin [1:0]
  connect \dut.rd_empty \dut.u_rd_ptr.rd_empty
  connect \dut.rd_data \rd_data
  connect \dut.rd_en \rd_en
  connect \dut.rd_rst_n \dut.u_rd_ptr.rd_rst_n
  connect \dut.rd_clk \rd_clk
  connect \dut.wr_full \dut.u_wr_ptr.wr_full
  connect \dut.wr_data \wr_data
  connect \dut.wr_en \wr_en
  connect \dut.wr_rst_n \dut.u_rd_ptr.rd_rst_n
  connect \dut.wr_clk \wr_clk
  connect \rd_empty \dut.u_rd_ptr.rd_empty
  connect \wr_full \dut.u_wr_ptr.wr_full
  connect \rst_n \dut.u_rd_ptr.rd_rst_n
  connect \wr_seen \tag_set
end
