[options]
# Free, independent clocks. Without this, sby models every flop as ticking
# on one shared clock every step, which is NOT a clock-domain-crossing model.
multiclock on

# Depth is 2**(ADDR_WIDTH+1) + 12 for the default ADDR_WIDTH=4. It must be
# deep enough to push the highest tag_seq through write, sync and read.
mode bmc
depth 20

[engines]
smtbmc z3

[script]
plugin -i slang
read_slang async_fifo.sv async_fifo_integrity_top.sv --top async_fifo_integrity_top
prep -top async_fifo_integrity_top

[files]
async_fifo.sv
async_fifo_integrity_top.sv
